{
    "compilerOptions": {
        "target": "ES2021",
        "module": "commonjs",
        "outDir": "./assets/js",
        "rootDir": "./assets/ts",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["es2021", "dom"]
    },
    "include": ["./assets/ts/**/*", "assets/js/recipes-dynamic.js", "assets/js/auth.js"]
}
